{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<BRAIN_DIR>/hooks/capture.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<BRAIN_DIR>/hooks/capture.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
